# Copia aquest fitxer a .env i omple els valors.
# Aquestes dues variables són públiques (es poden veure al bundle), però
# no hi posis mai service_role, contrasenyes de base de dades ni secrets.
VITE_SUPABASE_URL=https://el-teu-projecte.supabase.co
VITE_SUPABASE_ANON_KEY=la-teva-clau-anon-publica

# Opcional: si fas servir la nova publishable key en lloc de l'anon key.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
